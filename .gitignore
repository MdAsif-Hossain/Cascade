# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/

# --- Env / secrets ---
.env
.env.local
