# Copy to .env and fill in. Never commit .env.

# --- Provider API keys (free tiers) ---
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Embedding provider ---
# Hosted embedding API used by the classifier at inference time.
EMBEDDING_API_KEY=

# --- Database ---
# Local dev: sqlite (file-based). Production: Supabase Postgres connection string.
DATABASE_URL=sqlite:///./cascade.db

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
