# Copy to .env and fill in. Never commit .env.

# --- Provider API keys (free tiers) ---
# Verified working from Bangladesh on 2026-08-14.
# Cerebras was dropped: valid key, but HTTP 402 on every model — no free
# inference. See docs/adr/0001-provider-selection.md.
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
OPENROUTER_API_KEY=

# --- Embeddings ---
# Served by gemini-embedding-001 using GOOGLE_AI_STUDIO_API_KEY above.
# No separate key needed.

# --- Database ---
# Local dev: sqlite (file-based). Production: Supabase Postgres connection string.
DATABASE_URL=sqlite:///./cascade.db

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
